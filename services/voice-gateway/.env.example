PORT=8787
VOICE_PROVIDER=mock

# The web app's base URL and the shared secret used to call its internal
# call-session API (replaces the old shared Supabase connection — see
# src/lib/session-store.ts). INTERNAL_API_KEY must match the web app's
# value exactly.
WEB_APP_URL=http://localhost:3000
INTERNAL_API_KEY=replace-with-long-random-secret

VOICE_GATEWAY_SIGNING_SECRET=replace-with-same-secret-as-web
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
MAX_CALL_SECONDS=1800
