VOICE_GATEWAY_URL=http://localhost:8787
VOICE_GATEWAY_SIGNING_SECRET=replace-with-long-random-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret the voice gateway uses to call this app's internal
# call-session API (apps/web/src/app/api/internal/sessions/[id]/route.ts).
# Must match INTERNAL_API_KEY on services/voice-gateway exactly. Never
# exposed to the browser (no NEXT_PUBLIC_ prefix).
INTERNAL_API_KEY=replace-with-long-random-secret
