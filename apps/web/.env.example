VOICE_GATEWAY_URL=http://localhost:8787
VOICE_GATEWAY_SIGNING_SECRET=replace-with-long-random-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret the voice gateway uses to call this app's internal
# call-session API (apps/web/src/app/api/internal/sessions/[id]/route.ts).
# Must match INTERNAL_API_KEY on services/voice-gateway exactly. Never
# exposed to the browser (no NEXT_PUBLIC_ prefix).
INTERNAL_API_KEY=replace-with-long-random-secret

# Optional locally, REQUIRED for a real deployment (e.g. Vercel): backs
# leads/call-sessions/sales-inquiries with durable, multi-instance-safe
# Upstash Redis instead of the in-memory fallback (see
# apps/web/src/lib/server/store/index.ts). Without these set, the app
# still runs (using the in-memory store), but state will not survive
# across serverless invocations in production — see docs/DEPLOYMENT.md.
# Adding the Upstash integration from Vercel's Storage tab sets both of
# these automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
